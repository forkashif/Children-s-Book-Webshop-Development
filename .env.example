# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# SERVER CONFIGURATION
PORT=3000
NODE_ENV="development"
ADMIN_SESSION_SECRET="starlight_tales_super_secure_session_secret_2026"

# PRINT-ON-DEMAND (POD) PROVIDER CONFIGURATION
# Options: prodigi | gelato | printful
POD_PROVIDER="prodigi"

# Prodigi Settings (Default)
# Sandbox key for testing or production key for live fulfillment:
PRODIGI_API_KEY="test_prodigi_api_key_sandbox"
PRODIGI_ENVIRONMENT="sandbox" # "sandbox" or "live"
PRODIGI_WEBHOOK_SECRET="whsec_prodigi_test_secret"

# Gelato Settings (Alternative)
GELATO_API_KEY=""
GELATO_ENVIRONMENT="sandbox"

# Printful Settings (Alternative)
PRINTFUL_API_KEY=""

# STRIPE PAYMENTS CONFIGURATION
# Add your Stripe test or live credentials below:
STRIPE_SECRET_KEY="sk_test_placeholder_key"
STRIPE_PUBLISHABLE_KEY="pk_test_placeholder_key"
STRIPE_WEBHOOK_SECRET="whsec_placeholder_stripe_secret"

# PAYPAL (Optional)
PAYPAL_CLIENT_ID=""

# TRANSACTIONAL EMAIL (Resend or SendGrid)
# If left empty, system operates in console preview/mock mode with in-app tracking
EMAIL_PROVIDER="mock" # "resend" | "sendgrid" | "mock"
RESEND_API_KEY=""
SENDGRID_API_KEY=""
STORE_EMAIL="hello@starlighttales.com"
ADMIN_NOTIFICATION_EMAIL="admin@starlighttales.com"

